rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 每個人只能讀寫自己的資料（users/自己的 uid/ 底下），而且只能寫網站真的會用到的路徑和欄位。
    // 沒有列在下面的路徑（例如 users/{uid}/其他資料夾）一律拒絕，避免有人註冊帳號後把這裡當免費的雲端硬碟。
    // 欄位格式對應 js/firebase-remote.js；改了上傳的資料格式，要一起改這裡。
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 單字：每個字一份文件 { word, updatedAt, deleted, data（單字內容；刪除紀錄是 null）, syncedAt（伺服器時間）}
    match /users/{uid}/words/{wordId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && wordId.size() <= 300
        && request.resource.data.keys().hasOnly(['word', 'updatedAt', 'deleted', 'data', 'syncedAt'])
        && request.resource.data.word is string && request.resource.data.word.size() <= 100
        && request.resource.data.updatedAt is number
        && request.resource.data.deleted is bool
        && (request.resource.data.data == null || request.resource.data.data is map)
        && request.resource.data.syncedAt == request.time;
    }

    // 每台裝置自己的每日紀錄 { log: { 日期: {...} }, updatedAt }
    match /users/{uid}/logs/{deviceId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && deviceId.size() <= 64
        && request.resource.data.keys().hasOnly(['log', 'updatedAt'])
        && request.resource.data.log is map && request.resource.data.log.size() <= 4000
        && request.resource.data.updatedAt is number;
    }

    // 設定、錯題本、單字集 { value, updatedAt }
    match /users/{uid}/meta/{name} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && name in ['settings', 'mistakes', 'wordSets']
        && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && (request.resource.data.value is map || request.resource.data.value is list);
    }
  }
}
